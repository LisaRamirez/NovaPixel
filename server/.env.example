# Puerto donde escucha el backend
PORT=4000

# URL pública de tu sitio web (para redirigir tras el pago)
SITE_URL=https://novapixel.host

# Claves de Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_AQUI

# Secreto del webhook de Stripe (se genera al crear el endpoint en el dashboard,
# o al correr `stripe listen --forward-to localhost:4000/webhook/stripe`)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto compartido entre este backend y el plugin de Minecraft.
# Genera uno largo y aleatorio, por ejemplo con: openssl rand -hex 32
PLUGIN_SHARED_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Pon esto en "true" cuando el backend se sirva por HTTPS en producción,
# para que la cookie de sesión solo viaje cifrada. En local (http) déjalo
# en "false" o el navegador descartará la cookie.
COOKIE_SECURE=false

# API key de Resend (https://resend.com/api-keys) para enviar los correos
# de "olvidé mi contraseña".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de esos correos. Mientras no verifiques tu propio dominio en
# Resend, puedes usar su dirección de pruebas "onboarding@resend.dev"
# (funciona para enviar a cualquier destinatario, pero no se ve profesional).
RESEND_FROM_EMAIL=NovaPixel <onboarding@resend.dev>

# Credenciales de PayPal para comprar paquetes de Gilcoins. Créalas en
# https://developer.paypal.com/dashboard/applications — con una app de
# "Sandbox" te dan un Client ID y Secret de prueba al instante, sin
# necesidad de cuenta business real todavía.
PAYPAL_CLIENT_ID=tu-client-id-de-paypal
PAYPAL_CLIENT_SECRET=tu-client-secret-de-paypal

# "sandbox" para pruebas (no cobra dinero real) o "live" en producción.
PAYPAL_MODE=sandbox
