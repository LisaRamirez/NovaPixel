# Clave secreta interna de Django (firma de cookies/sesiones). Genera una
# larga y aleatoria en producción, ej. con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# "true" en desarrollo, "false" en producción.
DJANGO_DEBUG=true

# Dominios que puede servir este backend, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL pública de tu sitio web (para CORS, Stripe/PayPal y el link de reseteo
# de contraseña). Debe coincidir EXACTO con la URL real del sitio.
SITE_URL=https://novapixel.host

# Orígenes extra permitidos para CORS/CSRF, separados por coma. Normalmente
# se deja vacío; en desarrollo sirve para abrir el sitio desde otro equipo
# de la red local, ej. "http://192.168.1.81:8080".
EXTRA_ALLOWED_ORIGINS=

# Claves de Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_AQUI

# Secreto del webhook de Stripe (Developers → Webhooks → Add endpoint, URL
# https://tu-backend/webhook/stripe, evento checkout.session.completed).
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_AQUI

# Secreto compartido entre este backend y el plugin de Minecraft. Debe ser
# IDÉNTICO al "plugin-secret" en plugin/src/main/resources/config.yml.
# Genera uno largo, ej: python -c "import secrets; print(secrets.token_hex(32))"
PLUGIN_SHARED_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Pon esto en "true" cuando el backend se sirva por HTTPS en producción,
# para que la cookie de sesión solo viaje cifrada. En local (http) déjalo
# en "false" o el navegador descartará la cookie.
COOKIE_SECURE=false

# API key de Resend (https://resend.com/api-keys) para los correos de
# "olvidé mi contraseña".
RESEND_API_KEY=re_TU_CLAVE_AQUI

# Remitente de esos correos. Mientras no verifiques tu propio dominio en
# Resend, puedes usar su dirección de pruebas "onboarding@resend.dev".
RESEND_FROM_EMAIL=NovaPixel <onboarding@resend.dev>

# Credenciales de PayPal (https://developer.paypal.com/dashboard/applications).
# Una app en modo "Sandbox" te da un Client ID y Secret de prueba al instante.
PAYPAL_CLIENT_ID=tu-client-id-de-paypal
PAYPAL_CLIENT_SECRET=tu-client-secret-de-paypal

# "sandbox" para pruebas (no cobra dinero real) o "live" en producción.
PAYPAL_MODE=sandbox
